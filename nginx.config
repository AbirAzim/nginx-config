 http {
	server {
		listen 8080;
		root /home/ubuntu/content;

		location /images {
			root /home/ubuntu/;
		}

		location ~ .png$ {
			return 404;
		}
	}

	server {
		listen 80;

		location / {
			proxy_pass http://<ip>:8080/;
		}

		location /img {
			proxy_pass http://<ip>:8080/images/;
		}
	}
}

events {}
