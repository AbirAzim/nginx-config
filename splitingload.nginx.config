 http {
	upstream backends {
		server 127.0.0.0:1111;
		server 127.0.0.0:2222;
		server 127.0.0.0:3333;
	}

	upstream load1 {
                server 127.0.0.0:1111;
                server 127.0.0.0:2222;
	}

	upstream load2 {
		server 127.0.0.0:3333;
	}

	server {
		listen 8080;
		location / {
			proxy_pass http://backends/;
		}

		location /node1 {
			proxy_pass http://load1/;
		}

		location /node2 {
			proxy_pass http://load2/;
		}
	}
}

events {}
